{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Verilog / SystemVerilog",
  "scopeName": "source.verilog",
  "comment": "Invariant: every non-whitespace token gets a colour scope. The last rule is an identifier catch-all, so a name the specific rules do not know is still coloured as a variable instead of rendering in the theme's default foreground. Specific rules come first because TextMate stops at the first match at each position.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#attributes" },
    { "include": "#macros" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#typedef" },
    { "include": "#module-names" },
    { "include": "#class-extends" },
    { "include": "#subprograms" },
    { "include": "#labels" },
    { "include": "#port-connection" },
    { "include": "#module-instantiation" },
    { "include": "#system-tasks" },
    { "include": "#type-names" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#escaped-identifiers" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.verilog",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.block.verilog",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.verilog",
          "match": "//.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.define.verilog",
          "begin": "^\\s*(`define)\\b\\s*([A-Za-z_$][\\w$]*)?",
          "beginCaptures": {
            "1": { "name": "keyword.control.directive.verilog" },
            "2": { "name": "entity.name.function.preprocessor.verilog" }
          },
          "end": "(?<!\\\\)$",
          "patterns": [{ "include": "#preprocessor-body" }]
        },
        {
          "name": "meta.preprocessor.verilog",
          "begin": "^\\s*(`(?:begin_keywords|end_keywords|ifdef|ifndef|elsif|else|endif|include|undef|undefineall|timescale|default_nettype|celldefine|endcelldefine|resetall|unconnected_drive|nounconnected_drive|line|pragma|protect|endprotect|protected|endprotected|unprotected))\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.directive.verilog" }
          },
          "end": "(?<!\\\\)$",
          "patterns": [{ "include": "#preprocessor-body" }]
        }
      ]
    },
    "preprocessor-body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "name": "entity.name.function.preprocessor.verilog",
          "match": "`[A-Za-z_$][\\w$]*"
        },
        {
          "name": "punctuation.definition.string.verilog",
          "match": "`\""
        },
        { "include": "#type-names" },
        { "include": "#types" },
        {
          "name": "variable.other.preprocessor.verilog",
          "match": "[A-Za-z_$][\\w$]*"
        },
        { "include": "#operators" },
        { "include": "#punctuation" },
        {
          "name": "punctuation.other.preprocessor.verilog",
          "match": "\\S"
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.verilog",
      "comment": "`(*` opens an attribute, but `@(*)` is a sensitivity list, not an attribute. Without the negative lookahead the rule never closes and the rest of the file renders with no colour.",
      "begin": "\\(\\*(?!\\s*\\))",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.attribute.begin.verilog" }
      },
      "end": "\\*\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.attribute.end.verilog" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "name": "entity.other.attribute-name.verilog",
          "match": "[A-Za-z_$][\\w$]*"
        },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "punctuation.definition.string.verilog",
          "match": "`\""
        },
        {
          "name": "entity.name.function.preprocessor.verilog",
          "match": "`[A-Za-z_$][\\w$]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.macro.verilog",
          "match": "`[A-Za-z_$][\\w$]*"
        },
        {
          "name": "punctuation.definition.directive.verilog",
          "match": "`"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.verilog",
      "comment": "Verilog strings are single-line; ending at `$` as well keeps an unterminated quote from swallowing the rest of the file.",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.verilog", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.time.verilog",
          "match": "\\b\\d[\\d_]*\\s?(?:fs|ps|ns|us|ms|s|step)\\b"
        },
        {
          "name": "constant.numeric.real.verilog",
          "match": "\\b\\d[\\d_]*\\.[\\d_]*(?:[eE][-+]?\\d+)?\\b|\\b\\d[\\d_]*[eE][-+]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.verilog",
          "match": "\\b\\d[\\d_]*\\s*'[sS]?[bodhBODH]\\s*[0-9a-fA-FxXzZ?_]+"
        },
        {
          "name": "constant.numeric.integer.verilog",
          "match": "'[sS]?[bodhBODH][0-9a-fA-FxXzZ?_]+"
        },
        {
          "name": "constant.numeric.integer.verilog",
          "match": "\\b\\d[\\d_]*'[01xXzZ]\\b"
        },
        {
          "name": "constant.numeric.integer.verilog",
          "match": "'[01xXzZ]\\b"
        },
        {
          "name": "constant.numeric.integer.verilog",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "typedef": {
      "patterns": [
        {
          "name": "meta.typedef.verilog",
          "comment": "A begin/end region, not a match: the body may span lines and must keep its own colours. The end pattern names the declared type, which is the identifier written just before the final semicolon.",
          "begin": "\\btypedef\\b",
          "beginCaptures": {
            "0": { "name": "storage.modifier.verilog" }
          },
          "end": "([A-Za-z_$][\\w$]*)(\\s*;)",
          "endCaptures": {
            "1": { "name": "entity.name.type.verilog" },
            "2": { "name": "punctuation.terminator.verilog" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "meta.block.verilog",
              "comment": "Struct, union, enum and randsequence bodies keep their semicolons local so the typedef end only fires outside them.",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.block.begin.verilog" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.block.end.verilog" }
              },
              "patterns": [
                { "include": "#comments" },
                { "include": "#strings" },
                { "include": "#numbers" },
                { "include": "#keywords" },
                { "include": "#type-names" },
                { "include": "#types" },
                { "include": "#operators" },
                { "include": "#punctuation" },
                {
                  "name": "constant.other.enum-member.verilog",
                  "match": "[A-Z][A-Z0-9_]*"
                },
                { "include": "#identifiers" }
              ]
            },
            { "include": "#type-names" },
            { "include": "#types" },
            { "include": "#keywords" },
            { "include": "#operators" },
            { "include": "#punctuation" },
            {
              "name": "constant.other.enum-member.verilog",
              "match": "[A-Z][A-Z0-9_]*"
            },
            { "include": "#identifiers" }
          ]
        }
      ]
    },
    "module-names": {
      "patterns": [
        {
          "match": "\\b(module|macromodule|interface|package|program|class|checker|primitive|config)\\b\\s*([A-Za-z_$][\\w$]*)?",
          "captures": {
            "1": { "name": "keyword.control.module.verilog" },
            "2": { "name": "entity.name.type.module.verilog" }
          }
        },
        {
          "match": "\\b(endmodule|endinterface|endpackage|endprogram|endclass|endchecker|endprimitive|endconfig)\\b(\\s*:\\s*([A-Za-z_$][\\w$]*))?",
          "captures": {
            "1": { "name": "keyword.control.module.verilog" },
            "2": { "name": "punctuation.separator.label.verilog" },
            "3": { "name": "entity.name.type.module.verilog" }
          }
        }
      ]
    },
    "class-extends": {
      "patterns": [
        {
          "match": "\\b(extends|implements)\\b\\s*([A-Za-z_$][\\w$]*(?:\\s*::\\s*[A-Za-z_$][\\w$]*)?)",
          "captures": {
            "1": { "name": "keyword.other.class.verilog" },
            "2": { "name": "entity.name.type.verilog" }
          }
        }
      ]
    },
    "subprograms": {
      "patterns": [
        {
          "name": "meta.function.verilog",
          "comment": "The header only: it ends at the declaration's semicolon, so the body is tokenized as ordinary code. Inside it, the identifier before the port list is the function/task name.",
          "begin": "\\b(function|task)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.other.function.verilog" }
          },
          "end": "(?=;)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "entity.name.function.verilog",
              "match": "[A-Za-z_$][\\w$]*\\s*(?=\\()"
            },
            { "include": "#type-names" },
            { "include": "#types" },
            { "include": "#keywords" },
            { "include": "#operators" },
            { "include": "#punctuation" },
            { "include": "#identifiers" }
          ]
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "\\b(begin|end|fork|join|join_any|join_none|endfunction|endtask|endgroup|endproperty|endsequence|endclocking|endchecker|endgenerate)\\b(\\s*:\\s*([A-Za-z_$][\\w$]*))",
          "captures": {
            "1": { "name": "keyword.control.flow.verilog" },
            "2": { "name": "punctuation.separator.label.verilog" },
            "3": { "name": "entity.name.label.verilog" }
          }
        }
      ]
    },
    "port-connection": {
      "patterns": [
        {
          "match": "(?:^|(?<=[(,]))(\\s*\\.\\s*)([A-Za-z_$][\\w$]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.separator.dot.verilog" },
            "2": { "name": "variable.other.port.verilog" }
          }
        }
      ]
    },
    "module-instantiation": {
      "patterns": [
        {
          "match": "^\\s*(?!(?:accept_on|alias|always|always_comb|always_ff|always_latch|and|assert|assign|assume|automatic|before|begin|bind|bins|binsof|bit|break|buf|bufif0|bufif1|byte|case|casex|casez|cell|chandle|checker|class|clocking|cmos|config|const|constraint|context|continue|cover|covergroup|coverpoint|cross|deassign|default|defparam|design|disable|dist|do|edge|else|end|endcase|endchecker|endclass|endclocking|endconfig|endfunction|endgenerate|endgroup|endinterface|endmodule|endpackage|endprimitive|endprogram|endproperty|endsequence|endspecify|endtable|endtask|enum|event|eventually|expect|export|extends|extern|final|first_match|for|force|foreach|forever|fork|forkjoin|function|generate|genvar|global|highz0|highz1|if|iff|ifnone|ignore_bins|illegal_bins|implements|implies|import|incdir|include|initial|inout|input|inside|instance|int|integer|interconnect|interface|intersect|join|join_any|join_none|large|let|liblist|library|local|localparam|logic|longint|macromodule|matches|medium|modport|module|nand|negedge|nettype|new|nexttime|nmos|nor|noshowcancelled|not|notif0|notif1|null|or|output|package|packed|parameter|pmos|posedge|primitive|priority|program|property|protected|pull0|pull1|pulldown|pullup|pulsestyle_ondetect|pulsestyle_onevent|pure|rand|randc|randcase|randsequence|rcmos|real|realtime|ref|reg|reject_on|release|repeat|restrict|return|rnmos|rpmos|rtran|rtranif0|rtranif1|s_always|s_eventually|s_nexttime|s_until|s_until_with|scalared|sequence|shortint|shortreal|showcancelled|signed|small|soft|solve|specify|specparam|static|string|strong|strong0|strong1|struct|super|supply0|supply1|sync_accept_on|sync_reject_on|table|tagged|task|this|throughout|time|timeprecision|timeunit|tran|tranif0|tranif1|tri|tri0|tri1|triand|trior|trireg|type|typedef|union|unique|unique0|unsigned|until|until_with|untyped|use|uwire|var|vectored|virtual|void|wait|wait_order|wand|weak|weak0|weak1|while|wildcard|wire|with|within|wor|xnor|xor)\\b)(?:(?:\\w+\\s+)?(?:\\w+\\s+)?(\\w+)\\s+(#\\s*\\()|(?:\\w+\\s+)?(\\w+)\\s+(\\w+)\\s*(\\())",
          "captures": {
            "1": { "name": "entity.name.type.module.verilog" },
            "2": { "name": "punctuation.definition.parameters.verilog" },
            "3": { "name": "entity.name.type.module.verilog" },
            "4": { "name": "entity.name.label.module.verilog" },
            "5": { "name": "punctuation.definition.port-list.verilog" }
          }
        }
      ]
    },
    "system-tasks": {
      "patterns": [
        {
          "name": "support.function.system.verilog",
          "match": "\\$[A-Za-z_$][\\w$]*"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "entity.name.type.verilog",
          "comment": "Package-qualified type, `_t`-suffixed type, and capitalised type used in front of another identifier.",
          "match": "\\b[A-Za-z_$][\\w$]*\\s*::\\s*[A-Za-z_$][\\w$]*"
        },
        {
          "name": "entity.name.type.verilog",
          "match": "\\b[A-Za-z_][\\w$]*(?:_t|_T)\\b"
        },
        {
          "name": "entity.name.type.verilog",
          "match": "\\b[A-Z][A-Za-z0-9_$]*\\b(?=\\s+(?:[A-Za-z_$][\\w$]*\\s*[;,)=\\[]|[A-Za-z_$][\\w$]*\\s*$))"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.verilog",
          "match": "\\b(logic|bit|byte|shortint|int|longint|integer|time|real|realtime|shortreal|string|chandle|event|void|wire|tri|tri0|tri1|triand|trior|trireg|wand|wor|uwire|reg|supply0|supply1|enum|struct|union)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.verilog",
          "match": "\\b(if|else|case|casex|casez|endcase|default|unique|unique0|priority)\\b"
        },
        {
          "name": "keyword.control.loop.verilog",
          "match": "\\b(for|while|do|repeat|forever|foreach|break|continue|return|randcase|randsequence)\\b"
        },
        {
          "name": "keyword.control.flow.verilog",
          "match": "\\b(begin|end|fork|join|join_any|join_none|disable|wait|wait_order|assign|alias|force|release|deassign)\\b"
        },
        {
          "name": "keyword.other.sensitivity.verilog",
          "match": "\\b(always|always_comb|always_ff|always_latch|initial|final|posedge|negedge|edge|or)\\b"
        },
        {
          "name": "keyword.declaration.verilog",
          "match": "\\b(input|output|inout|ref|const|static|automatic|signed|unsigned|genvar|var)\\b"
        },
        {
          "name": "storage.modifier.verilog",
          "match": "\\b(parameter|localparam|specparam|defparam|typedef|import|export)\\b"
        },
        {
          "name": "keyword.other.generate.verilog",
          "match": "\\b(generate|endgenerate)\\b"
        },
        {
          "name": "keyword.other.function.verilog",
          "match": "\\b(function|endfunction|task|endtask)\\b"
        },
        {
          "name": "keyword.other.gate.verilog",
          "match": "\\b(and|nand|nor|xor|xnor|buf|not|bufif0|bufif1|notif0|notif1|pmos|nmos|rpmos|rnmos|cmos|rcmos|tran|tranif0|tranif1|rtran|rtranif0|rtranif1|pullup|pulldown)\\b"
        },
        {
          "name": "keyword.other.strength.verilog",
          "match": "\\b(highz0|highz1|pull0|pull1|strong0|strong1|weak0|weak1|strong|weak|large|medium|small|scalared|vectored|noshowcancelled|showcancelled|pulsestyle_ondetect|pulsestyle_onevent)\\b"
        },
        {
          "name": "keyword.other.config.verilog",
          "match": "\\b(cell|design|enddesign|instance|liblist|incdir|include|use|library)\\b"
        },
        {
          "name": "keyword.other.assertion.verilog",
          "match": "\\b(assert|assume|cover|restrict|expect|property|endproperty|sequence|endsequence|eventually|nexttime|s_always|s_eventually|s_nexttime|s_until|s_until_with|until|until_with|iff|implies|first_match|throughout|within|intersect|matches|accept_on|reject_on|sync_accept_on|sync_reject_on|before)\\b"
        },
        {
          "name": "keyword.other.coverage.verilog",
          "match": "\\b(covergroup|endgroup|coverpoint|cross|bins|binsof|ignore_bins|illegal_bins|dist|inside)\\b"
        },
        {
          "name": "keyword.other.clocking.verilog",
          "match": "\\b(clocking|endclocking|modport|specify|endspecify|table|endtable|timeunit|timeprecision|nettype|interconnect|let|type|global|context|untyped|packed|tagged|with|wildcard|std)\\b"
        },
        {
          "name": "keyword.other.class.verilog",
          "match": "\\b(extends|implements|extern|pure|virtual|local|protected|super|this|new|null|rand|randc|constraint|soft|solve)\\b"
        },
        {
          "name": "keyword.other.verilog",
          "match": "\\b(bind|checker|endchecker|primitive|endprimitive|config|endconfig)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.separator.scope.verilog",
          "match": "::"
        },
        {
          "name": "punctuation.definition.parameters.verilog",
          "match": "#\\s*\\("
        },
        {
          "name": "keyword.operator.arrow.verilog",
          "match": "->>|->|=>|\\|->|\\|=>|#-#|#=#"
        },
        {
          "name": "keyword.operator.comparison.verilog",
          "match": "===|!==|==|!=|>=|<=|&&|\\|\\||\\^~|~\\^|==\\?|!=\\?"
        },
        {
          "name": "keyword.operator.assignment.verilog",
          "match": "\\?\\?=|\\*\\*>|<<<=|>>>=|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|:=|="
        },
        {
          "name": "keyword.operator.bitwise.verilog",
          "match": "<<<|>>>|<<|>>|\\*\\*"
        },
        {
          "name": "keyword.operator.arithmetic.verilog",
          "match": "\\+\\+|--|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.verilog",
          "match": "[~&|^]"
        },
        {
          "name": "keyword.operator.comparison.verilog",
          "match": "[!<>]"
        },
        {
          "name": "keyword.operator.ternary.verilog",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.event.verilog",
          "match": "@"
        },
        {
          "name": "keyword.operator.assertion.verilog",
          "match": "##"
        },
        {
          "name": "keyword.operator.delay.verilog",
          "match": "#"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.scope.verilog",
          "match": "::"
        },
        {
          "name": "punctuation.definition.parameters.verilog",
          "match": "#\\s*\\("
        },
        {
          "name": "punctuation.definition.assignment-pattern.verilog",
          "match": "'\\s*\\{"
        },
        { "name": "punctuation.section.parens.begin.verilog", "match": "\\(" },
        { "name": "punctuation.section.parens.end.verilog", "match": "\\)" },
        { "name": "punctuation.section.brackets.begin.verilog", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.verilog", "match": "\\]" },
        { "name": "punctuation.section.braces.begin.verilog", "match": "\\{" },
        { "name": "punctuation.section.braces.end.verilog", "match": "\\}" },
        { "name": "punctuation.terminator.verilog", "match": ";" },
        { "name": "punctuation.separator.comma.verilog", "match": "," },
        { "name": "punctuation.separator.dot.verilog", "match": "\\." },
        { "name": "punctuation.definition.cast.verilog", "match": "'(?=\\s*\\()" },
        { "name": "punctuation.definition.escaped.verilog", "match": "\\\\" }
      ]
    },
    "escaped-identifiers": {
      "patterns": [
        {
          "name": "variable.other.escaped.verilog",
          "match": "\\\\[^\\s]+"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.verilog",
          "comment": "Catch-all: a name no other rule claimed is still a variable, never the theme's default foreground.",
          "match": "[A-Za-z_$][A-Za-z0-9_$]*"
        }
      ]
    }
  }
}
